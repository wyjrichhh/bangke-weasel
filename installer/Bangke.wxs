<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
    ProductCode 每次打包生成，UpgradeCode 稳定。
    MSI 的升级比较只看前三段；AllowSameVersionUpgrades 用于重新打包。
    第四段仅与二进制构建标签保持一致，不能当作唯一或递增的升级版本。
    正式功能更新必须升 VERSION_PATCH 并重编全部二进制。
  -->
  <Package Name="蚌壳拼音"
           Codepage="65001"
           Language="2052"
           Version="$(var.Version)"
           Manufacturer="Bangke"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes"
           UpgradeCode="8F1D4B33-9C2A-4E6D-B0F7-3A5C8E21D940">

    <SummaryInformation Description="蚌壳拼音输入法 $(var.Version)" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="已安装更高版本的蚌壳拼音，无法降级安装。" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.ResourceDir)\bangke.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <!-- Repairs use this distribution EXE, which supplies and recaches its MSI.
         The Windows cached MSI cannot recover payload from deleted temp dirs. -->
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPHELPLINK" Value="https://shellim.openbankai.com/" />

    <!--
      这里【不能】用 REINSTALLMODE=amus 之类强制全量重装来绕开「版本不更高就
      跳过」:那会把覆盖安装变成同版本重装,而本项目历史上正是被这条路坑过
      —— 重装链会把 TSF 注册(regsvr32 那步)一起丢掉,输入法直接从语言栏消失,
      回滚还留下一条重启删除 System32\bangke.dll 的记录。0.4.44 实测复现。
      正确做法是让每个包的 dll 版本号真的变大:先改 env.bat 的 VERSION_PATCH,
      再跑 bk-rebuild(它才会把新版本戳盖进所有二进制),然后才打包。
    -->

    <!--
      目录：ProgramFiles\Bangke Pinyin（BangkeRoot）；
      output\ 全量文件由 harvest.ps1 生成的 Files.wxs 提供
    -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="Bangke Pinyin" />
    </StandardDirectory>

    <Feature Id="Main" Title="蚌壳拼音" Level="1">
      <ComponentGroupRef Id="BangkeFiles" />
      <ComponentRef Id="C_BangkeDll" />
      <ComponentRef Id="C_Registry" />
      <ComponentRef Id="C_Shortcuts" />
    </Feature>

    <!-- System32\bangke.dll：TSF 输入法服务 -->
    <StandardDirectory Id="System64Folder">
      <Component Id="C_BangkeDll" Guid="A9C3E5D1-7F2B-4C86-9A40-2D5E6B81C733">
        <File Id="BangkeDll" Source="$(var.OutputDir)\bangkex64.dll" Name="bangke.dll" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- BangkeRoot / ServerExecutable / 自启动 -->
    <Component Id="C_Registry" Guid="3E7A9C15-6B48-4F0D-8E92-1C4D5A70F866" Directory="INSTALLDIR">
      <RegistryValue Root="HKLM" Key="Software\Bangke" Name="BangkeRoot"
                     Value="[INSTALLDIR]" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\Bangke" Name="ServerExecutable"
                     Value="BangkeServer.exe" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="BangkeServer" Value="&quot;[INSTALLDIR]BangkeServer.exe&quot;" Type="string" />
    </Component>

    <!-- 开始菜单 -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="BangkeMenuDir" Name="蚌壳拼音" />
    </StandardDirectory>
    <Component Id="C_Shortcuts" Guid="5C2E8A71-D94B-4E35-A6F0-8B1D7E24C959" Directory="BangkeMenuDir">
      <RegistryValue Root="HKLM" Key="Software\Bangke" Name="Shortcuts"
                     Value="1" Type="integer" KeyPath="yes" />
      <Shortcut Id="ScSettings" Name="设置"
                Target="[INSTALLDIR]BangkeSettings.exe" WorkingDirectory="INSTALLDIR" />
      <Shortcut Id="ScDict" Name="词典管理"
                Target="[INSTALLDIR]BangkeSettings.exe" Arguments="/dict" WorkingDirectory="INSTALLDIR" />
      <Shortcut Id="ScSync" Name="同步用户数据"
                Target="[INSTALLDIR]BangkeSettings.exe" Arguments="/sync" WorkingDirectory="INSTALLDIR" />
      <Shortcut Id="ScDeploy" Name="重新部署"
                Target="[INSTALLDIR]BangkeSettings.exe" Arguments="/deploy" WorkingDirectory="INSTALLDIR" />
      <RemoveFolder Id="RemoveBangkeMenuDir" On="uninstall" />
    </Component>

    <!--
      自定义动作（deferred）：卸注册 → 装文件 → 注册 → 首部署
      停服不在这条链上 —— 见下面的 util:CloseApplication
      Directory 型 EXE CA：工作目录即所引目录，System32 工具用相对名调用
    -->
    <!--
      regsvr32 必须以安装用户身份跑：DllRegisterServer 里的 RegisterProfile 是
      「把输入法加进当前用户的输入列表」的 API，以 SYSTEM 身份跑就加进了 SYSTEM 的列表
      —— 结果是机器层面全注册齐了（InprocServer32、LanguageProfile 的 Enable=1 都在），
      但用户 Win+Space 切不过去，表现成"装完只能打英文"。
      延迟 CA + Impersonate="yes" 仍带管理员令牌，写 System32/HKLM 不受影响。
    -->
    <CustomAction Id="UnregisterTSF" Directory="System64Folder"
                  ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /u /s &quot;[System64Folder]bangke.dll&quot;"
                  Return="ignore" Execute="deferred" Impersonate="yes" />
    <CustomAction Id="RegisterTSF" Directory="System64Folder"
                  ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[System64Folder]bangke.dll&quot;"
                  Return="check" Execute="deferred" Impersonate="yes" />
    <!-- 首部署写用户目录，必须以安装用户身份跑，否则落到 systemprofile -->
    <CustomAction Id="FirstDeploy" Directory="INSTALLDIR"
                  ExeCommand="&quot;[INSTALLDIR]BangkeSettings.exe&quot; /install restoredefault"
                  Return="check" Execute="deferred" Impersonate="yes" />

    <!-- 装完即用：以安装用户身份 fire-and-forget 拉起服务（cmd start 避免 CA 等待常驻进程） -->
    <CustomAction Id="StartServer" Directory="WindowsFolder"
                  ExeCommand="&quot;[WindowsFolder]explorer.exe&quot; &quot;[INSTALLDIR]BangkeServer.exe&quot;"
                  Return="ignore" Execute="deferred" Impersonate="yes" />

    <!--
      卸载残留清理：在 RemoveFiles 之前跑（此时 BangkeSettings.exe 尚在）。
      被应用进程加载的 System32\bangke.dll 删不掉时转由下次重启删除；
      本产品自启注册由 MSI 维护，清理不修改其他输入法。
    -->
    <CustomAction Id="Cleanup" Directory="INSTALLDIR"
                  ExeCommand="&quot;[INSTALLDIR]BangkeSettings.exe&quot; /cleanup"
                  Return="ignore" Execute="deferred" Impersonate="no" />

    <!-- 卸载挂起的重启删除若不清掉，卸载后未重启就重装会在下次重启吃掉新装文件 -->
    <CustomAction Id="ClearPendingDelete" Directory="INSTALLDIR"
                  ExeCommand="&quot;[INSTALLDIR]BangkeSettings.exe&quot; /clearpending"
                  Return="ignore" Execute="deferred" Impersonate="no" />

    <!--
      停服改用 Restart Manager：原来是一条跑 taskkill.exe 的 CA，而 taskkill 是控制台程序
      —— 从没有控制台的进程里拉起它，Windows 会新建一个控制台窗口，安装时那个一闪而过的
      黑框就是它。这个元素由扩展自己的 CA 处理，不起控制台。
      只对 Package 合法（不在 Component 下），且各项要显式给：RebootPrompt 默认为 yes
      （会弹重启提示），TerminateProcess 收的是"进程退出码"而非布尔值，给了它 RebootPrompt
      必须是 no。Timeout 默认 5 秒 —— 服务端不会应答关闭消息，等于白等，压到 2 秒。
    -->
    <util:CloseApplication Id="CloseServer"
                           Target="BangkeServer.exe"
                           CloseMessage="no"
                           RebootPrompt="no"
                           PromptToContinue="no"
                           TerminateProcess="1"
                           Timeout="2" />

    <util:CloseApplication Id="CloseUpdateMonitor"
                           Target="BangkeSettings.exe"
                           CloseMessage="yes"
                           RebootPrompt="no"
                           PromptToContinue="no"
                           TerminateProcess="1"
                           Timeout="2" />

    <InstallExecuteSequence>
      <Custom Action="UnregisterTSF" After="InstallInitialize" Condition="REMOVE" />
      <Custom Action="Cleanup" After="UnregisterTSF" Condition="REMOVE" />
      <!-- 须在 InstallFiles 之后：CA 用的 BangkeSettings.exe 由该步装入 -->
      <Custom Action="ClearPendingDelete" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="RegisterTSF" After="ClearPendingDelete" Condition="NOT REMOVE" />
      <Custom Action="FirstDeploy" After="WriteRegistryValues" Condition="NOT REMOVE" />
      <Custom Action="StartServer" After="FirstDeploy" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
